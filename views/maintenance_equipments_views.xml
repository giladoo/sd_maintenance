<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="hr_equipment_view_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_no" />

            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_tree_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_no" />

            </xpath>
        </field>
    </record>

    <record id="hr_equipment_view_search_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_no" />

            </xpath>
        </field>
    </record>
    <record id="hr_equipment_view_kanban_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='serial_no']" position="before">
                <field name="asset_no" class="fw-bold fs-5"/>

            </xpath>
        </field>
    </record>

</odoo>